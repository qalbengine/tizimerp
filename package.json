{
  "name": "avtotest-bot",
  "version": "1.0.0",
  "private": true,
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "test": "node --test test/finance.test.js test/receipt.test.js test/web.test.js",
    "test:e2e": "node test/e2e.js",
    "postinstall": "prisma generate",
    "build": "npm --prefix web install --include=dev && npm --prefix web run build",
    "start:prod": "prisma migrate deploy && node prisma/seed.js && node bot.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pdfkit": "^0.15.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=18"
  }
}
